---
const { title, url, time} = Astro.props;
---
<style>

  li {
    padding: 10px;
    background-color: var(--color-void);
    list-style-type: none;
  }

  ul {
    padding: 1px 1px;
    list-style-type: none;
  }
</style>

  <ul>
      <li>
    <a href={url}>{title}</a>

    <a href="">{time}</a>
  </li>

  </ul>

