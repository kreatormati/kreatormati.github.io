---
const { title, url, pubDate, tags} = Astro.props;
import { defineCollection } from 'astro:content';
---
<style>

  li {
    padding: 10px;
    list-style-type: square;
  }

  ul {
    padding: 1px 1px;
    list-style-type: none;
  }
</style>

  <ul>
      <li>
    <a href={url}>{title}</a>
    <p>{tags}</p>
    <a href="">{pubDate}</a>
  </li>

  </ul>

