---
import Layout from "../layouts/layout.astro";
const homeTitle = ">_m";
---
<style>
  .menu {
    position: relative;
  }

  .dropdown {
    position: absolute;
    top: 100%;
    display: none;
    right: 0;
    background:#d6c9ba;
    padding: 10px;
    z-index: 10;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .menu:hover .dropdown {
    display: block;
    width: 100%;
    height: 100%;
    z-index: 10;
    right: 0;
    top: 0;
    
  }

  @media (max-width:600px) {
    .menu .icon {
      display: content;
    }
  }
  
</style>
<nav class="mobile">
  <h1 style="color: #D49A45; font-style: "InterDisplay"; font-weight: 600; "> <a href="/">{homeTitle}</a></h1>
  <div class="mobile menu">
    <button class=" menu icon">󰍜</button>
    <ul class="dropdown">
    <li><a href="/">Home</a></li>
    <li><a href=""></a>Github<span class="icon">󰏌</span></li>
    <li><a href="/about">About</a></li>
    <li><a href="/contact">Contact</a></li>
    </ul>
      
    </div>
</nav>

