---
import Layout from "../layouts/layout.astro";
const homeTitle = ">_m";
const allPosts = Object.values(import.meta.glob('../content/posts/*.md', { eager: true }));
import mdpost from  "../layouts/mdpost.astro";
---

<Layout title={homeTitle}>
  <div>
  <ul>
    {allPosts.map((post: any) => <mdpost url={post.url} title={post.frontmatter.title} />)}
  </ul>
<ul>
  {allPosts.map((post: any) => (
    <li>
      <a href={post.url}>{post.frontmatter.title}</a>
    </li>
  ))}
</ul>
  </div>
</Layout>
